# Python environments and caches
**/venv/
.venv/
**/__pycache__/
*.py[co]
.pytest_cache/

# Player data and secrets: never commit
**/.env
**/bot_settings.json
local_data/
/recordings/
.codex/
.dbvictory/

# Diagnostics written while the bot runs
sniff_log.txt
**/*_debug*.txt
**/*_dump.txt
**/*.bin
/dll/*.txt
**/electron_err.log

# Build output
/dll/*.dll
/dll/*.o
/build/
/DBVictory Launcher.exe
*.tsbuildinfo

# Panel (Next.js); next-env.d.ts is regenerated by `next typegen` and `next build`
node_modules/
/dashboard/.next/
/dashboard/.next-*/
/dashboard/next-env.d.ts
/dashboard/public/local-spells/
